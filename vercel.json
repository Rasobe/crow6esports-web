{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "regions": ["cdg1"],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^en.*"
        }
      ],
      "destination": "/en",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/es",
      "permanent": true
    }
  ]
}
