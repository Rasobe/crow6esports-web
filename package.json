    "link-ai-context": "mkdir -p .claude && ln -sf ../../ai-context/.agents/skills .claude/skills && ln -sf ../ai-context/CLAUDE.md CLAUDE-global.md"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/react": "^7.1.2",
    "@astrojs/vercel": "^11.0.17",
    "@hookform/resolvers": "^5.9.1",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.9",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^7.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "resend": "^6.37.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "sass": "^1.101.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.9"
  },
  "type": "module",
  "lint-staged": {
    "*.{ts,astro}": [
      "eslint --fix",
      "prettier --write"
