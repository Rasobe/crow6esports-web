{
  "name": "crow6esports",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "e2e": "playwright test",
    "prepare": "husky",
    "link-ai-context": "mkdir -p .claude && ln -sf ../../ai-context/.agents/skills .claude/skills && ln -sf ../ai-context/CLAUDE.md CLAUDE-global.md"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/vercel": "^11.0.13",
    "@stripe/stripe-js": "^9.7.0",
    "astro": "^7.3.8",
    "resend": "^6.12.4",
    "stripe": "^22.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^20",
    "eslint": "^9",
    "eslint-plugin-astro": "^3.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "sass": "^1.101.0",
    "typescript": "^5",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.9"
  },
  "type": "module",
  "lint-staged": {
    "*.{ts,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,scss,md}": [
      "prettier --write"
    ]
  }
}
