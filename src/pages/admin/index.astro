---
import { getAttributionSummary } from "@/application/admin/attribution-summary";
import { getAdminOverview } from "@/application/admin/tryout-requests";
import { container } from "@/infrastructure/container";
import { AdminOverview } from "@/ui/features/admin/components";
import { AdminLayout } from "@/ui/layouts";

const repository = container.tryoutRequestRepository;
const [overview, attribution] = await Promise.all([
  getAdminOverview(repository),
  getAttributionSummary(repository),
]);
---

<AdminLayout title="Resumen" current="overview">
  <AdminOverview overview={overview} attribution={attribution} />
</AdminLayout>
