---
import { TRYOUTS_OPEN } from "astro:env/server";
import { TryoutsPage } from "@/ui/features/tryouts/components";
import { LocaleLayout } from "@/ui/layouts";
import { createTranslator } from "@/ui/i18n";
import { ROUTES } from "@config/routes";

const t = createTranslator(Astro.locals.locale, "tryouts.seo");
---

<LocaleLayout
  title={t(TRYOUTS_OPEN ? "title" : "title_closed")}
  description={t("description")}
  path={ROUTES.tryouts}
>
  <TryoutsPage />
</LocaleLayout>
