---
import TryoutsPage from "@/ui/features/tryouts/components/TryoutsPage.astro";
import LocaleLayout from "@/ui/layouts/LocaleLayout.astro";
import { createTranslator } from "@/ui/i18n";
import { ROUTES } from "@config/routes";

const t = createTranslator(Astro.locals.locale, "tryouts.meta");
---

<LocaleLayout title={t("title")} description={t("description")} path={ROUTES.tryouts}>
  <TryoutsPage />
</LocaleLayout>
