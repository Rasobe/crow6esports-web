---
import { TryoutsPage } from "@/ui/features/tryouts/components";
import { LocaleLayout } from "@/ui/layouts";
import { createTranslator } from "@/ui/i18n";
import { ROUTES } from "@config/routes";

const t = createTranslator(Astro.locals.locale, "tryouts.seo");
---

<LocaleLayout title={t("title")} description={t("description")} path={ROUTES.tryouts}>
  <TryoutsPage />
</LocaleLayout>
