---
import { TeamPage } from "@/ui/features/team/components";
import { LocaleLayout } from "@/ui/layouts";
import { createTranslator } from "@/ui/i18n";
import { ROUTES } from "@config/routes";

const t = createTranslator(Astro.locals.locale, "team.seo");
---

<LocaleLayout title={t("title")} description={t("description")} path={ROUTES.team}>
  <TeamPage />
</LocaleLayout>
