---
import { CLUB } from "@config/club";
import { ROUTES } from "@config/routes";
import { siteConfig } from "@config/site";
import {
  getActivePlayers,
  getStaffMembers,
  getSubstitutePlayers,
} from "@/application/team/get-players";
import { container } from "@/infrastructure/container";
import { TeamPage } from "@/ui/features/team/components";
import { LocaleLayout } from "@/ui/layouts";
import { createTranslator, localizePath } from "@/ui/i18n";
import { JsonLd } from "@/ui/shared/components";
import { pageBreadcrumbs } from "@/ui/shared/lib/page-breadcrumbs";
import { rosterTeamData } from "@/ui/shared/lib/structured-data";

const { locale } = Astro.locals;
const t = createTranslator(locale, "team.seo");
const { playerRepository } = container;

// Quien pidió anonimato no entra en los datos estructurados
const named = (players: readonly { nickname: string; anonymous: boolean }[]) =>
  players.filter((player) => !player.anonymous).map((player) => player.nickname);

const roster = rosterTeamData({
  name: siteConfig.name,
  url: `${siteConfig.url}${localizePath(locale, ROUTES.team)}`,
  sport: CLUB.game,
  siteUrl: siteConfig.url,
  athletes: [
    ...named(getActivePlayers(playerRepository)),
    ...named(getSubstitutePlayers(playerRepository)),
  ],
  coaches: named(getStaffMembers(playerRepository)),
});

const breadcrumbs = pageBreadcrumbs(locale, [
  { name: createTranslator(locale, "nav")("team"), path: ROUTES.team },
]);
---

<LocaleLayout title={t("title")} description={t("description")} path={ROUTES.team}>
  <JsonLd slot="head" data={roster} />
  <JsonLd slot="head" data={breadcrumbs} />
  <TeamPage />
</LocaleLayout>
