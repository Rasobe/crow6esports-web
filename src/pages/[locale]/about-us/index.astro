---
import { CLUB } from "@config/club";
import { ROUTES } from "@config/routes";
import { siteConfig } from "@config/site";
import { AboutPage } from "@/ui/features/about/components";
import { LocaleLayout } from "@/ui/layouts";
import { createTranslator, localizePath } from "@/ui/i18n";
import { JsonLd } from "@/ui/shared/components";
import { pageBreadcrumbs } from "@/ui/shared/lib/page-breadcrumbs";
import { aboutPageData } from "@/ui/shared/lib/structured-data";

const { locale } = Astro.locals;
const t = createTranslator(locale, "about.seo");
const description = t("description", { year: CLUB.foundedYear, city: CLUB.location.city });

const about = aboutPageData({
  name: t("title"),
  description,
  url: `${siteConfig.url}${localizePath(locale, ROUTES.aboutUs)}`,
  inLanguage: locale,
  siteUrl: siteConfig.url,
});

const breadcrumbs = pageBreadcrumbs(locale, [
  { name: createTranslator(locale, "nav")("about_us"), path: ROUTES.aboutUs },
]);
---

<LocaleLayout title={t("title")} description={description} path={ROUTES.aboutUs}>
  <JsonLd slot="head" data={about} />
  <JsonLd slot="head" data={breadcrumbs} />
  <AboutPage />
</LocaleLayout>
