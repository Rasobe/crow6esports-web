---
import { AboutPage } from "@/ui/features/about/components";
import { LocaleLayout } from "@/ui/layouts";
import { createTranslator } from "@/ui/i18n";
import { ROUTES } from "@config/routes";

const t = createTranslator(Astro.locals.locale, "about.meta");
---

<LocaleLayout title={t("title")} description={t("description")} path={ROUTES.aboutUs}>
  <AboutPage />
</LocaleLayout>
