---
import { CLUB } from "@config/club";
import { siteConfig, socialUrls } from "@config/site";
import { HomePage } from "@/ui/features/home/components";
import { LocaleLayout } from "@/ui/layouts";
import { createTranslator } from "@/ui/i18n";
import { JsonLd } from "@/ui/shared/components";
import { clubGraphData } from "@/ui/shared/lib/structured-data";

const t = createTranslator(Astro.locals.locale, "home.seo");
const description = t("description", { year: CLUB.foundedYear, city: CLUB.location.city });
const club = clubGraphData({
  name: siteConfig.name,
  url: siteConfig.url,
  logo: `${siteConfig.url}/icon-512.png`,
  sport: CLUB.game,
  email: CLUB.email,
  foundingYear: CLUB.foundedYear,
  description,
  alternateName: CLUB.alternateNames,
  location: CLUB.location,
  sameAs: socialUrls,
});
---

<LocaleLayout title={t("title")} absoluteTitle description={description}>
  <JsonLd slot="head" data={club} />
  <HomePage />
</LocaleLayout>
