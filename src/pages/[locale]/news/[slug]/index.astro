---
import { getArticleBySlug } from "@/application/news/get-articles";
import { container } from "@/infrastructure/container";
import { renderArticleContent } from "@/infrastructure/news/article-content";
import { ArticleDetail } from "@/ui/features/news/components";
import { LocaleLayout } from "@/ui/layouts";
import { ROUTES } from "@config/routes";

const { slug = "" } = Astro.params;
const article = await getArticleBySlug(container.articleRepository, slug);
const rendered = await renderArticleContent(slug);

if (!article || !rendered) return Astro.rewrite("/404");

const { Content } = rendered;
---

<LocaleLayout title={article.title} description={article.excerpt} path={`${ROUTES.news}/${slug}`}>
  <ArticleDetail article={article}>
    <Content />
  </ArticleDetail>
</LocaleLayout>
