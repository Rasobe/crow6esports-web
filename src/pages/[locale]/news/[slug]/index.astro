---
import { ROUTES } from "@config/routes";
import { siteConfig } from "@config/site";
import { getArticleView } from "@/application/news/get-articles";
import { lastModified } from "@/domain/news/article";
import { container } from "@/infrastructure/container";
import { renderArticleContent } from "@/infrastructure/news/article-content";
import { ArticleDetail } from "@/ui/features/news/components";
import { articleLocalePaths } from "@/ui/features/news/lib/article-locale-paths";
import { LocaleLayout } from "@/ui/layouts";
import { createTranslator } from "@/ui/i18n";
import { JsonLd } from "@/ui/shared/components";
import { articleData, breadcrumbData } from "@/ui/shared/lib/structured-data";

const { slug = "" } = Astro.params;
const { locale } = Astro.locals;
const view = await getArticleView(container.articleRepository, slug, locale);
const rendered = view && (await renderArticleContent(slug));

if (!view || !rendered) return Astro.rewrite("/404");

const { article, translation } = view;
const { Content } = rendered;

const path = `${ROUTES.news}/${article.slug}`;
// Sin traducción no hay hreflang: un objeto vacío lo omite
const alternates = translation
  ? { [article.locale]: path, [translation.locale]: `${ROUTES.news}/${translation.slug}` }
  : {};
const localePaths = articleLocalePaths(article, translation, ROUTES.news);
const modified = lastModified(article);

const structuredData = articleData({
  headline: article.title,
  description: article.excerpt,
  url: `${siteConfig.url}/${locale}${path}`,
  image: new URL(article.cover, siteConfig.url).href,
  datePublished: article.date,
  dateModified: modified,
  inLanguage: locale,
  publisher: {
    name: siteConfig.name,
    url: siteConfig.url,
    logo: `${siteConfig.url}/icon-512.png`,
  },
});
const localeUrl = `${siteConfig.url}/${locale}`;
const breadcrumbs = breadcrumbData([
  { name: siteConfig.name, url: localeUrl },
  { name: createTranslator(locale, "nav")("news"), url: `${localeUrl}${ROUTES.news}` },
  { name: article.title, url: `${localeUrl}${path}` },
]);
---

<LocaleLayout
  title={article.title}
  description={article.excerpt}
  path={path}
  ogType="article"
  image={article.cover}
  imageAlt={article.coverAlt}
  alternates={alternates}
  localePaths={localePaths}
  publishedTime={article.date}
  modifiedTime={modified}
>
  <JsonLd slot="head" data={structuredData} />
  <JsonLd slot="head" data={breadcrumbs} />
  <ArticleDetail article={article}>
    <Content />
  </ArticleDetail>
</LocaleLayout>
