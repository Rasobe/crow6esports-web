---
import { StorePage } from "@/ui/features/store/components";
import { LocaleLayout } from "@/ui/layouts";
import { createTranslator } from "@/ui/i18n";
import { ROUTES } from "@config/routes";
import { STORE_ENABLED } from "@config/store";

const t = createTranslator(Astro.locals.locale, "store.seo");
---

<LocaleLayout
  title={t("title")}
  description={t(STORE_ENABLED ? "description_in_stock" : "description")}
  path={ROUTES.store}
>
  <StorePage />
</LocaleLayout>
