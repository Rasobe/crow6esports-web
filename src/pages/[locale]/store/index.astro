---
import { StorePage } from "@/ui/features/store/components";
import { LocaleLayout } from "@/ui/layouts";
import { createTranslator } from "@/ui/i18n";
import { ROUTES } from "@config/routes";

const t = createTranslator(Astro.locals.locale, "store.meta");
---

<LocaleLayout title={t("title")} description={t("description")} path={ROUTES.store}>
  <StorePage />
</LocaleLayout>
