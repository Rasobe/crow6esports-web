---
import { COACHING } from "@config/coaching";
import { ROUTES } from "@config/routes";
import { siteConfig } from "@config/site";
import { CoachingPage } from "@/ui/features/coaching/components";
import { LocaleLayout } from "@/ui/layouts";
import { createTranslator, localizePath } from "@/ui/i18n";
import { JsonLd } from "@/ui/shared/components";
import { coachingServiceData } from "@/ui/shared/lib/structured-data";

const { locale } = Astro.locals;
const t = createTranslator(locale, "coaching.meta");
const service = coachingServiceData({
  name: t("title"),
  description: t("description"),
  url: `${siteConfig.url}${localizePath(locale, ROUTES.coaching)}`,
  provider: { name: siteConfig.name, url: siteConfig.url },
  currency: COACHING.currency,
  plans: [...COACHING.plans.individual, ...COACHING.plans.teams],
});
---

<LocaleLayout title={t("title")} description={t("description")} path={ROUTES.coaching}>
  <JsonLd slot="head" data={service} />
  <CoachingPage />
</LocaleLayout>
