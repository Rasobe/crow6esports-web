---
import "./news-page.scss";
import { getArticles } from "@/application/news/get-articles";
import { container } from "@/infrastructure/container";
import { createTranslator } from "@/ui/i18n";
import { PageHeader } from "@/ui/shared/components";
import ArticleCard from "./ArticleCard.astro";
import NewsEmpty from "./NewsEmpty.astro";

const t = createTranslator(Astro.locals.locale, "news");
const articles = await getArticles(container.articleRepository);
---

<PageHeader
  eyebrow={t("eyebrow")}
  title={t("title")}
  description={t("meta.description")}
  image="turf"
/>

{articles.length === 0 ? (
  <NewsEmpty />
) : (
  <section class="news-list" aria-label={t("list_label")}>
    <ul class="news-list__grid">
      {articles.map((article) => (
        <li class="news-list__item" data-reveal>
          <ArticleCard article={article} />
        </li>
      ))}
    </ul>
  </section>
)}
