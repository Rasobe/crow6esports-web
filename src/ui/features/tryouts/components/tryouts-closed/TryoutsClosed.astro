---
import "./tryouts-closed.scss";
import { DISCORD_URL } from "@config/site";
import { createTranslator } from "@/ui/i18n";
import { Button, Icon } from "@/ui/shared/components";

const t = createTranslator(Astro.locals.locale, "tryouts.closed");
---

<div class="tryouts-closed">
  <div class="tryouts-closed__inner">
    <span class="tryouts-closed__icon">
      <Icon name="lock" size={24} />
    </span>
    <p class="section-label">{t("eyebrow")}</p>
    <h1 class="tryouts-closed__title">{t("title")}</h1>
    <p class="tryouts-closed__desc">{t("desc")}</p>
    <Button href={DISCORD_URL} size="lg">
      {t("cta")}
    </Button>
  </div>
</div>
