---
import "./video-highlight.scss";
import { HIGHLIGHTS_VIDEO_ID } from "@config/media";
import { createTranslator } from "@/ui/i18n";

// Variantes generadas con sharp: AVIF q45 y WebP q72
const POSTER_WIDTHS = [800, 1200, 1600];
const POSTER_SIZES = "(min-width: 80rem) 75rem, 100vw";
const posterSrcset = (format: "avif" | "webp") =>
  POSTER_WIDTHS.map((width) => `/images/highlights-poster-${width}.${format} ${width}w`).join(", ");

const t = createTranslator(Astro.locals.locale, "home.videoHighlight");
---

<section class="video-highlight" aria-labelledby="video-highlight-title">
  <div class="video-highlight__inner">
    <header class="video-highlight__header" data-reveal>
      <span class="section-label">{t("eyebrow")}</span>
      <h2 id="video-highlight-title" class="video-highlight__title">
        {t("title_lead")} <span class="video-highlight__accent">{t("title_accent")}</span>
      </h2>
      <p class="video-highlight__description">{t("description")}</p>
    </header>

    <video-player
      class="video-highlight__player"
      data-video-id={HIGHLIGHTS_VIDEO_ID}
      data-label={t("video_label")}
      data-reveal
    >
      <picture>
        <source type="image/avif" srcset={posterSrcset("avif")} sizes={POSTER_SIZES} />
        <img
          class="video-highlight__poster"
          src="/images/highlights-poster-1200.webp"
          srcset={posterSrcset("webp")}
          sizes={POSTER_SIZES}
          width="1600"
          height="900"
          alt={t("poster_alt")}
          loading="lazy"
          decoding="async"
        />
      </picture>
      <button type="button" class="video-highlight__play" aria-label={t("play")}>
        <span class="video-highlight__play-icon" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 14 14" fill="currentColor">
            <path d="M3.5 2l8 5-8 5z" />
          </svg>
        </span>
        <span class="video-highlight__play-label">{t("play_label")}</span>
      </button>
    </video-player>
  </div>
</section>

<script>
  class VideoPlayer extends HTMLElement {
    connectedCallback() {
      this.querySelector<HTMLButtonElement>(".video-highlight__play")?.addEventListener(
        "click",
        () => this.load(),
        { once: true },
      );
    }

    private load() {
      const { videoId, label } = this.dataset;
      if (!videoId) return;

      const params = new URLSearchParams({ autoplay: "1", rel: "0", playsinline: "1" });
      const frame = document.createElement("iframe");
      frame.className = "video-highlight__frame";
      frame.src = `https://www.youtube-nocookie.com/embed/${videoId}?${params}`;
      frame.title = label ?? "";
      frame.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
      frame.referrerPolicy = "strict-origin-when-cross-origin";
      frame.allowFullscreen = true;

      this.replaceChildren(frame);
      this.setAttribute("data-playing", "");
      frame.focus();
    }
  }

  if (!customElements.get("video-player")) {
    customElements.define("video-player", VideoPlayer);
  }
</script>
