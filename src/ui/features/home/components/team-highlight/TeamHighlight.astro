---
import "./team-highlight.scss";
import { ROUTES } from "@config/routes";
import { getAllPlayers } from "@/application/team/get-players";
import { container } from "@/infrastructure/container";
import { createTranslator } from "@/ui/i18n";
import { Button, PlayerCard, SectionHeader } from "@/ui/shared/components";

const HIGHLIGHTED_PLAYERS = 4;

const t = createTranslator(Astro.locals.locale, "home.teamHighlight");
const players = getAllPlayers(container.playerRepository).slice(0, HIGHLIGHTED_PLAYERS);
---

<section class="team-highlight">
  <div class="team-highlight__inner">
    <SectionHeader namespace="home.teamHighlight" />

    <div class="team-highlight__grid">
      {players.map((player, index) => (
        <PlayerCard player={player} index={index} />
      ))}
    </div>

    <div class="team-highlight__footer">
      <Button href={ROUTES.team} variant="outline">
        {t("cta_view_more")}
      </Button>
    </div>
  </div>
</section>
