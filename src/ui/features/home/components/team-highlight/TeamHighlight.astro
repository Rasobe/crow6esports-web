---
import "./team-highlight.scss";
import { ROUTES } from "@config/routes";
import { getActivePlayers, getSubstitutePlayers } from "@/application/team/get-players";
import { container } from "@/infrastructure/container";
import { createTranslator, localizePath } from "@/ui/i18n";
import { PlayerCard, SectionHeading, SectionBackdrop } from "@/ui/shared/components";

const { locale } = Astro.locals;
const t = createTranslator(locale, "home.teamHighlight");
const { playerRepository } = container;
const players = [...getActivePlayers(playerRepository), ...getSubstitutePlayers(playerRepository)];
---

<section class="team-highlight has-backdrop" aria-labelledby="team-highlight-title">
  <SectionBackdrop image="lights" />
  <div class="team-highlight__inner">
    <SectionHeading
      id="team-highlight-title"
      eyebrow={t("eyebrow")}
      title={t("title_lead")}
      accent={t("title_accent")}
      href={localizePath(locale, ROUTES.team)}
      linkLabel={t("cta_view_more")}
    />

    <div class="team-highlight__grid">
      {players.map((player, index) => (
        <div class="team-highlight__item" data-reveal>
          <PlayerCard player={player} index={index} />
        </div>
      ))}
    </div>
  </div>
</section>
