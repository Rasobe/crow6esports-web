---
import "./team-highlight.scss";
import { ROUTES } from "@config/routes";
import { getAllPlayers } from "@/application/team/get-players";
import { container } from "@/infrastructure/container";
import { createTranslator, localizePath } from "@/ui/i18n";
import { PlayerCard, SectionHeading } from "@/ui/shared/components";

const HIGHLIGHTED_PLAYERS = 4;

const { locale } = Astro.locals;
const t = createTranslator(locale, "home.teamHighlight");
const players = getAllPlayers(container.playerRepository).slice(0, HIGHLIGHTED_PLAYERS);
---

<section class="team-highlight" aria-labelledby="team-highlight-title">
  <div class="team-highlight__inner">
    <SectionHeading
      id="team-highlight-title"
      eyebrow={t("eyebrow")}
      title={t("title_lead")}
      accent={t("title_accent")}
      href={localizePath(locale, ROUTES.team)}
      linkLabel={t("cta_view_more")}
    />

    <div class="team-highlight__grid">
      {players.map((player, index) => (
        <PlayerCard player={player} index={index} />
      ))}
    </div>
  </div>
</section>
