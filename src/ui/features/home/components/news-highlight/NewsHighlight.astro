---
import "./news-highlight.scss";
import { ROUTES } from "@config/routes";
import { getArticles } from "@/application/news/get-articles";
import { container } from "@/infrastructure/container";
import { ArticleCard } from "@/ui/features/news/components";
import { createTranslator, localizePath } from "@/ui/i18n";
import { SectionHeading } from "@/ui/shared/components";

const HIGHLIGHTED_ARTICLES = 3;

const { locale } = Astro.locals;
const t = createTranslator(locale, "home.newsHighlight");
const articles = (await getArticles(container.articleRepository, locale)).slice(
  0,
  HIGHLIGHTED_ARTICLES,
);
---

{articles.length > 0 && (
  <section class="news-highlight" aria-labelledby="news-highlight-title">
    <div class="news-highlight__inner">
      <SectionHeading
        id="news-highlight-title"
        eyebrow={t("eyebrow")}
        title={t("title")}
        href={localizePath(locale, ROUTES.news)}
        linkLabel={t("cta_view_more")}
      />
      <ul class="news-highlight__grid">
        {articles.map((article) => (
          <li class="news-highlight__item" data-reveal>
            <ArticleCard article={article} />
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
