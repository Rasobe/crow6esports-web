---
import "./hero-section.scss";
import { ROUTES } from "@config/routes";
import { getArticles } from "@/application/news/get-articles";
import { getRosterStats } from "@/application/team/get-roster-stats";
import { container } from "@/infrastructure/container";
import { createTranslator, localizePath } from "@/ui/i18n";
import { Button } from "@/ui/shared/components";
import { getClubYears } from "@/ui/shared/lib/club-info";

const { locale } = Astro.locals;
const t = createTranslator(locale, "home.hero");
const { playerCount, peakMmr } = getRosterStats(container.playerRepository);
const [latestArticle] = await getArticles(container.articleRepository, locale);
const latestDate =
  latestArticle &&
  new Intl.DateTimeFormat(locale, { day: "numeric", month: "short", timeZone: "UTC" }).format(
    latestArticle.date,
  );

// Variantes generadas con sharp: AVIF q45 y WebP q72
const HERO_WIDTHS = [640, 960, 1280, 1731];
const heroSrcset = (format: "avif" | "webp") =>
  HERO_WIDTHS.map((width) => `/images/hero-bg-${width}.${format} ${width}w`).join(", ");

const stats = [
  { key: "years", value: getClubYears() },
  { key: "players", value: playerCount },
  { key: "peak", value: peakMmr },
];
---

<section class="hero" aria-labelledby="hero-heading">
  <picture>
    <source type="image/avif" srcset={heroSrcset("avif")} sizes="100vw" />
    <img
      class="hero__bg"
      src="/images/hero-bg-1280.webp"
      srcset={heroSrcset("webp")}
      sizes="100vw"
      alt={t("image_alt")}
      width="1731"
      height="909"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <div class="hero__shade" aria-hidden="true"></div>
  <div class="hero__sweep" aria-hidden="true"></div>

  <div class="hero__inner">
    <div class="hero__content">
      {latestArticle && (
        <a
          class="hero__latest"
          href={localizePath(locale, `${ROUTES.news}/${latestArticle.slug}`)}
          data-hero
          style="--hero-step: 0"
        >
          <span class="hero__latest-dot" aria-hidden="true"></span>
          <span class="hero__latest-label">{t("latest")}</span>
          <time class="hero__latest-date" datetime={latestArticle.date.toISOString()}>
            {latestDate}
          </time>
          <span class="hero__latest-title">{latestArticle.title}</span>
        </a>
      )}
      <h1 id="hero-heading" class="hero-title">
        <span class="hero-title__line" data-hero style="--hero-step: 1">
          {t("title.name")} <span class="hero-title__plate">{t("title.number")}</span>
        </span>{" "}
        <span class="hero-title__line" data-hero style="--hero-step: 2">
          {t("title.sector")}
        </span>
        <span class="hero-title__sr-only">{t("title_separator")} </span>
        <span class="hero-subtitle" data-hero style="--hero-step: 3">
          {t("subtitle")}
        </span>
      </h1>

      <div class="hero__ctas" data-hero style="--hero-step: 4">
        <Button href={ROUTES.tryouts} size="lg">
          {t("cta_join")}
        </Button>
        <Button href={ROUTES.team} variant="brand-outline" size="lg" class="hero__cta-secondary">
          {t("cta_team")}
        </Button>
      </div>
    </div>

    <dl class="hero__stats" data-hero style="--hero-step: 5" aria-label={t("stats.label")}>
      {stats.map(({ key, value }, index) => (
        <div class:list={["hero__stat", { "hero__stat--brand": index === 0 }]}>
          <dt class="hero__stat-label">{t(`stats.${key}`)}</dt>
          <dd class="hero__stat-value" data-count-to={value}>
            {value.toLocaleString(locale)}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
