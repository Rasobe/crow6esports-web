---
import "./hero-section.scss";
import { ROUTES } from "@config/routes";
import { TEAM_STATS } from "@config/stats";
import { createTranslator } from "@/ui/i18n";
import { Button } from "@/ui/shared/components";

const t = createTranslator(Astro.locals.locale, "home.hero");

const stats = [
  { value: TEAM_STATS.wins, label: t("stats.wins") },
  { value: TEAM_STATS.tournaments, label: t("stats.tournaments") },
  { value: TEAM_STATS.players, label: t("stats.players") },
  { value: TEAM_STATS.championships, label: t("stats.championships") },
];
---

<section class="hero" aria-labelledby="hero-heading">
  <img
    class="hero__bg"
    src="/images/hero-bg.jpg"
    alt=""
    width="1920"
    height="1080"
    fetchpriority="high"
    decoding="async"
    aria-hidden="true"
  />
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="hero__inner">
    <div class="hero__content">
      <h1 id="hero-heading" class="hero-title">
        <span class="hero-title__line">
          {t("title.name")} <span class="hero-title__accent">{t("title.number")}</span>
        </span>
        <span class="hero-title__line text-stroke-brand">{t("title.sector")}</span>
      </h1>

      <p class="hero-subtitle">{t("subtitle")}</p>

      <div class="hero__ctas">
        <Button href={ROUTES.tryouts} size="lg">{t("cta_join")}</Button>
        <Button href={ROUTES.team} variant="brand-outline" size="lg">{t("cta_team")}</Button>
      </div>
    </div>

    <dl class="hero__stats" aria-label={t("stats.label")}>
      {stats.map((stat, index) => (
        <div class:list={["hero__stat", { "hero__stat--brand": index === 0 }]}>
          <dt class="hero__stat-label">{stat.label}</dt>
          <dd class="hero__stat-value">{stat.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
