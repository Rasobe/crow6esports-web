---
import "./hero-section.scss";
import { CLUB } from "@config/club";
import { ROUTES } from "@config/routes";
import { getRosterStats } from "@/application/team/get-roster-stats";
import { container } from "@/infrastructure/container";
import { createTranslator } from "@/ui/i18n";
import { Button } from "@/ui/shared/components";
import { getClubYears } from "@/ui/shared/lib/club-info";

const { locale } = Astro.locals;
const t = createTranslator(locale, "home.hero");
const { playerCount, peakMmr } = getRosterStats(container.playerRepository);

// Variantes generadas con sharp: AVIF q45 y WebP q72
const HERO_WIDTHS = [640, 960, 1280, 1774];
const heroSrcset = (format: "avif" | "webp") =>
  HERO_WIDTHS.map((width) => `/images/hero-bg-${width}.${format} ${width}w`).join(", ");

const stats = [
  { key: "years", value: getClubYears() },
  { key: "players", value: playerCount },
  { key: "peak", value: peakMmr },
  { key: "game", text: CLUB.game },
];
---

<section class="hero" aria-labelledby="hero-heading">
  <picture>
    <source type="image/avif" srcset={heroSrcset("avif")} sizes="100vw" />
    <img
      class="hero__bg"
      src="/images/hero-bg-1280.webp"
      srcset={heroSrcset("webp")}
      sizes="100vw"
      alt={t("image_alt")}
      width="1774"
      height="887"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <div class="hero__shade" aria-hidden="true"></div>
  <div class="hero__sweep" aria-hidden="true"></div>

  <div class="hero__inner">
    <div class="hero__content">
      <h1 id="hero-heading" class="hero-title">
        <span class="hero-title__line" data-hero style="--hero-step: 0">
          {t("title.name")} <span class="hero-title__accent">{t("title.number")}</span>
        </span>{" "}
        <span class="hero-title__line text-stroke-brand" data-hero style="--hero-step: 1">
          {t("title.sector")}
        </span>
        <span class="hero-title__sr-only">{t("title_separator")} </span>
        <span class="hero-subtitle" data-hero style="--hero-step: 2">
          {t("subtitle")}
        </span>
      </h1>

      <div class="hero__ctas" data-hero style="--hero-step: 3">
        <Button href={ROUTES.tryouts} size="lg">
          {t("cta_join")}
        </Button>
        <Button href={ROUTES.team} variant="brand-outline" size="lg">
          {t("cta_team")}
        </Button>
      </div>
    </div>

    <dl class="hero__stats" data-hero style="--hero-step: 4" aria-label={t("stats.label")}>
      {stats.map(({ key, value, text }, index) => (
        <div
          class:list={[
            "hero__stat",
            { "hero__stat--brand": index === 0, "hero__stat--text": value === undefined },
          ]}
        >
          <dt class="hero__stat-label">{t(`stats.${key}`)}</dt>
          {value === undefined ? (
            <dd class="hero__stat-value">{text}</dd>
          ) : (
            <dd class="hero__stat-value" data-count-to={value}>
              {value.toLocaleString(locale)}
            </dd>
          )}
        </div>
      ))}
    </dl>
  </div>
</section>
