---
import "./store-highlight.scss";
import { ROUTES } from "@config/routes";
import { DISCORD_URL } from "@config/site";
import { STORE_IN_STOCK } from "@config/store";
import { getProducts } from "@/application/store/get-products";
import { container } from "@/infrastructure/container";
import { createTranslator, localizePath } from "@/ui/i18n";
import { Button, SectionHeading, SectionBackdrop } from "@/ui/shared/components";
import { ProductCard } from "@/ui/features/store/components";

const HIGHLIGHTED_PRODUCTS = 4;

const { locale } = Astro.locals;
const t = createTranslator(locale, "home.storeHighlight");
const tNext = createTranslator(locale, "store.next_edition");
const products = getProducts(container.productRepository).slice(0, HIGHLIGHTED_PRODUCTS);
---

<section class="store-highlight has-backdrop" aria-labelledby="store-highlight-title">
  <SectionBackdrop image="turf" />
  <div class="store-highlight__inner">
    <SectionHeading
      id="store-highlight-title"
      eyebrow={t("eyebrow")}
      title={t("title")}
      href={localizePath(locale, ROUTES.store)}
      linkLabel={t("cta_view_more")}
    />

    <div
      class:list={[
        "store-highlight__layout",
        { "store-highlight__layout--teaser": !STORE_IN_STOCK },
      ]}
    >
      <div class="store-highlight__grid">
        {products.map((product) => (
          <div class="store-highlight__item" data-reveal>
            <ProductCard product={product} />
          </div>
        ))}
      </div>

      {!STORE_IN_STOCK && (
        <div class="store-highlight__teaser" data-reveal>
          <span class="section-label">{tNext("eyebrow")}</span>
          <p class="store-highlight__teaser-text">{tNext("teaser")}</p>
          <Button href={DISCORD_URL} variant="brand-outline">
            {tNext("cta_discord")}
          </Button>
        </div>
      )}
    </div>
  </div>
</section>
