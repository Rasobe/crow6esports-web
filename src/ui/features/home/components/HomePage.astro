---
import { TRYOUTS_OPEN } from "astro:env/server";
import { ANNOUNCEMENTS } from "@config/announcements";
import { getAnnouncementKeys } from "@/application/site/get-announcements";
import { createTranslator } from "@/ui/i18n";
import { NewsTicker } from "@/ui/shared/components";
import { CoachingBanner } from "./coaching-banner";
import { HeroSection } from "./hero-section";
import { StoreHighlight } from "./store-highlight";
import { TeamHighlight } from "./team-highlight";
import { TryoutsBanner } from "./tryouts-banner";

const t = createTranslator(Astro.locals.locale, "home.ticker");
const tickerItems = getAnnouncementKeys(ANNOUNCEMENTS, { tryoutsOpen: TRYOUTS_OPEN }).map((key) =>
  t(`items.${key}`),
);
---

<HeroSection />
<NewsTicker items={tickerItems} label={t("label")} pauseLabel={t("pause")} />
<TeamHighlight />
<CoachingBanner />
<StoreHighlight />
<TryoutsBanner />
