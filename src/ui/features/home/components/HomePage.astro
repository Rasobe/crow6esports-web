---
import { TRYOUTS_OPEN } from "astro:env/server";
import { ANNOUNCEMENTS } from "@config/announcements";
import { getAnnouncementKeys } from "@/application/site/get-announcements";
import { ROUTES } from "@config/routes";
import { createTranslator, localizePath } from "@/ui/i18n";
import { NewsTicker, Testimonials } from "@/ui/shared/components";
import { CoachingBanner } from "./coaching-banner";
import { HeroSection } from "./hero-section";
import { NewsHighlight } from "./news-highlight";
import { StoreHighlight } from "./store-highlight";
import { TeamHighlight } from "./team-highlight";
import { TryoutsBanner } from "./tryouts-banner";
import { VideoHighlight } from "./video-highlight";

const { locale } = Astro.locals;
const t = createTranslator(locale, "home.ticker");
const tt = createTranslator(locale, "testimonials");
const tickerItems = getAnnouncementKeys(ANNOUNCEMENTS, { tryoutsOpen: TRYOUTS_OPEN }).map((key) =>
  t(`items.${key}`),
);
---

<HeroSection />
<NewsTicker items={tickerItems} label={t("label")} pauseLabel={t("pause")} />
<TeamHighlight />
<VideoHighlight />
<CoachingBanner />
<Testimonials>
  <a slot="actions" class="testimonials__link" href={localizePath(locale, ROUTES.coaching)}>
    {tt("home_link")}
  </a>
</Testimonials>
<StoreHighlight />
<NewsHighlight />
<TryoutsBanner />
