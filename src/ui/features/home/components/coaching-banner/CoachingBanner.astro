---
import "./coaching-banner.scss";
import { COACHING } from "@config/coaching";
import { ROUTES } from "@config/routes";
import { getStartingPlan } from "@/domain/coaching/coaching-plan";
import { yearsSince } from "@/domain/site/years";
import { createTranslator, localizePath } from "@/ui/i18n";
import { Button, Icon } from "@/ui/shared/components";

const { locale } = Astro.locals;
const t = createTranslator(locale, "home.coachingBanner");

const { coach, results, plans } = COACHING;
const { price: startingPrice } = getStartingPlan(plans.individual);
const years = yearsSince(coach.startYear);

const figures = [
  { key: "years", value: years, suffix: "" },
  { key: "hours", value: coach.hoursPlayed, suffix: "+" },
  { key: "mmr", value: results.maxMmrReached, suffix: "+" },
];
---

<section class="coaching-banner" aria-labelledby="coaching-banner-title">
  <div class="coaching-banner__inner">
    <figure class="coaching-banner__coach">
      <div class="coaching-banner__photo">
        {coach.photo ? (
          <img
            class="coaching-banner__image"
            src={coach.photo}
            alt={coach.name}
            loading="lazy"
            decoding="async"
          />
        ) : (
          <img
            class="coaching-banner__placeholder"
            src="/images/brand/crow6-mascot-full.svg"
            alt=""
            aria-hidden="true"
            loading="lazy"
            decoding="async"
            width="2163"
            height="1525"
          />
        )}

        <figcaption class="coaching-banner__caption">
          <div class="coaching-banner__identity">
            <span class="coaching-banner__role">{t("coach_role")}</span>
            <span class="coaching-banner__name">{coach.name}</span>
          </div>
        </figcaption>
      </div>
    </figure>

    <div class="coaching-banner__content">
      <h2 id="coaching-banner-title" class="coaching-banner__title">
        {t("title_lead")} <span class="coaching-banner__title-accent">{t("title_accent")}</span>{" "}
        {t("title_tail")}
      </h2>

      <p class="coaching-banner__description">{t("description", { years })}</p>

      <dl class="coaching-banner__figures" aria-label={t("figures_label")}>
        {figures.map(({ key, value, suffix }) => (
          <div class="coaching-banner__figure">
            <dt class="coaching-banner__figure-label">{t(`figure_${key}`)}</dt>
            <dd class="coaching-banner__figure-value">
              <span data-count-to={value}>{value.toLocaleString(locale)}</span>
              {suffix}
            </dd>
          </div>
        ))}
      </dl>

      <div class="coaching-banner__actions">
        <Button href={ROUTES.coaching} size="lg" class="coaching-banner__cta">
          {t("cta_reserve")}
          <Icon name="arrow-right" size={18} />
        </Button>
        <p class="coaching-banner__from">
          {t("price_from")}
          <strong class="coaching-banner__from-amount">{startingPrice}€</strong>
          {t("price_unit")}
        </p>
        <a class="coaching-banner__more" href={localizePath(locale, ROUTES.coaching)}>
          {t("cta_more")}
        </a>
      </div>
    </div>
  </div>
</section>
