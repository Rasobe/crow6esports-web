---
import "./about-page.scss";
import { ABOUT_VALUES } from "@config/about";
import { CLUB } from "@config/club";
import { ACHIEVEMENTS, ROSTER_2022, ROSTER_2022_YEAR, type ClubDate } from "@config/history";
import { DISCORD_URL, socialLinks } from "@config/site";
import { getRosterStats } from "@/application/team/get-roster-stats";
import { container } from "@/infrastructure/container";
import { createTranslator } from "@/ui/i18n";
import { Button, Icon, PageHeader } from "@/ui/shared/components";

const { locale } = Astro.locals;
const t = createTranslator(locale, "about");
const { playerCount } = getRosterStats(container.playerRepository);

const ordinal = new Intl.PluralRules(locale, { type: "ordinal" });
const formatDate = ({ year, month, day }: ClubDate) =>
  month && day
    ? new Intl.DateTimeFormat(locale, { dateStyle: "long" }).format(new Date(year, month - 1, day))
    : String(year);
const toIsoDate = ({ year, month, day }: ClubDate) =>
  month && day
    ? `${year}-${String(month).padStart(2, "0")}-${String(day).padStart(2, "0")}`
    : String(year);
---

<PageHeader eyebrow={t("eyebrow")} title={t("title")} description={t("meta.description")} />

<section class="about-story" aria-labelledby="about-story-title">
  <div class="about-story__inner">
    <h2 id="about-story-title" class="about-story__title" data-reveal>
      {t("story.title")}
    </h2>
    <div class="about-story__text" data-reveal>
      <p>{t("story.founded", { year: CLUB.foundedYear, game: CLUB.game })}</p>
      <p>{t("story.today", { players: playerCount })}</p>
    </div>
  </div>
</section>

<section class="about-history" aria-labelledby="about-history-title">
  <div class="about-history__inner">
    <h2 id="about-history-title" class="about-history__title" data-reveal>
      {t("history.title")}
    </h2>
    <ol class="about-history__list">
      {ACHIEVEMENTS.map(({ event, date, onsite, result, lineup }) => (
        <li class="achievement" data-reveal>
          <p class="achievement__result">
            {result.kind === "winner"
              ? t("history.winner")
              : t("history.placement", {
                  place: result.place,
                  suffix: t(`history.ordinal.${ordinal.select(result.place)}`),
                })}
          </p>
          <h3 class="achievement__event">{event}</h3>
          <p class="achievement__meta">
            <time datetime={toIsoDate(date)}>{formatDate(date)}</time>
            {onsite && <span class="achievement__tag">{t("history.onsite")}</span>}
          </p>
          <p class="achievement__lineup">
            <span class="achievement__lineup-label">{t("history.lineup")}</span>
            {lineup.join(" · ")}
          </p>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="about-roster" aria-labelledby="about-roster-title">
  <div class="about-roster__inner">
    <h2 id="about-roster-title" class="about-roster__title" data-reveal>
      {t("history.roster_title", { year: ROSTER_2022_YEAR })}
    </h2>
    <ul class="about-roster__list">
      {ROSTER_2022.map(({ handle, role }) => (
        <li data-reveal>
          <a
            class="member"
            href={`https://x.com/${handle}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`@${handle} (${t("contact.new_tab")})`}
          >
            <span class="member__role">{t(`history.roles.${role}`)}</span>
            <span class="member__handle">@{handle}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="about-values" aria-labelledby="about-values-title">
  <div class="about-values__inner">
    <h2 id="about-values-title" class="about-values__title" data-reveal>
      {t("values.title")}
    </h2>
    <ul class="about-values__list">
      {ABOUT_VALUES.map((value, index) => (
        <li class="about-values__item" data-reveal>
          <span class="about-values__index" aria-hidden="true">
            {String(index + 1).padStart(2, "0")}
          </span>
          <h3 class="about-values__name">{t(`values.items.${value}.title`)}</h3>
          <p class="about-values__description">{t(`values.items.${value}.description`)}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="about-contact" aria-labelledby="about-contact-title">
  <div class="about-contact__inner" data-reveal>
    <h2 id="about-contact-title" class="about-contact__title">
      {t("contact.title")}
    </h2>
    <ul class="about-contact__list">
      <li class="about-contact__item">
        <Icon name="mail" size={16} />
        <a href={`mailto:${CLUB.email}`}>{CLUB.email}</a>
      </li>
    </ul>
    <ul class="about-contact__socials" aria-label={t("contact.socials_label")}>
      {socialLinks.map(({ platform, href, label }) => (
        <li>
          <a
            class="about-contact__social"
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${label} (${t("contact.new_tab")})`}
          >
            <Icon name={platform} size={20} />
          </a>
        </li>
      ))}
    </ul>
    <Button href={DISCORD_URL} size="lg">
      {t("contact.discord")}
    </Button>
  </div>
</section>
