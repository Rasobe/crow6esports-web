---
import "./next-edition.scss";
import { DISCORD_URL } from "@config/site";
import { CLUB } from "@config/club";
import type { Product } from "@/domain/store/product";
import { createTranslator } from "@/ui/i18n";
import { Button } from "@/ui/shared/components";
import { storeImageSrcset } from "@/ui/shared/lib/responsive-image";
import JerseyStage from "./JerseyStage.astro";
import type { JerseyView } from "./jersey-view";

interface Props {
  products: Product[];
}

const VIEWS = ["front", "back"] as const;

const { products } = Astro.props;
const t = createTranslator(Astro.locals.locale, "store");
const tNext = createTranslator(Astro.locals.locale, "store.next_edition");
const tShowcase = createTranslator(Astro.locals.locale, "store.showcase");
const views: JerseyView[] = products.flatMap(({ name, images }) =>
  images.flatMap((src) => {
    const view = VIEWS.find((candidate) => src.includes(candidate));
    return view ? [{ src, alt: name, view }] : [];
  }),
);
---

<section class="next-edition" aria-labelledby="next-edition-title">
  <jersey-gallery class="next-edition__inner">
    <JerseyStage views={views} />

    <div class="next-edition__panel" data-reveal>
      <div class="next-edition__status">
        <span class="next-edition__badge">{t("sold_out")}</span>
        <span class="next-edition__status-note">{tShowcase("status_note")}</span>
      </div>

      <h2 id="next-edition-title" class="next-edition__title">
        {tShowcase("title_lead")}{" "}
        <span class="next-edition__title-accent">{tShowcase("title_accent")}</span>
      </h2>

      <p class="next-edition__description">{tNext("description")}</p>

      {views.length > 0 && (
        <div class="next-edition__views">
          <span id="jersey-views-label" class="next-edition__views-label">
            {tShowcase("views_label")}
          </span>
          <div class="next-edition__gallery" role="tablist" aria-labelledby="jersey-views-label">
            <button
              type="button"
              role="tab"
              id="jersey-tab-video"
              class="next-edition__tab"
              aria-selected="true"
              aria-controls="jersey-panel-video"
              data-caption={tShowcase("club")}
            >
              <img
                class="next-edition__image next-edition__image--cover"
                src="/images/jersey-video-poster.webp"
                alt=""
                width="640"
                height="800"
                loading="lazy"
                decoding="async"
              />
              <span class="next-edition__tab-label">{tShowcase("view_video")}</span>
            </button>
            {views.map(({ src, view }) => (
              <button
                type="button"
                role="tab"
                id={`jersey-tab-${view}`}
                class="next-edition__tab"
                aria-selected="false"
                aria-controls={`jersey-panel-${view}`}
                tabindex="-1"
                data-caption={tShowcase(`view_${view}`)}
              >
                <img
                  class="next-edition__image"
                  src={src}
                  srcset={storeImageSrcset(src)}
                  sizes="(min-width: 48rem) 8rem, 28vw"
                  alt=""
                  width="640"
                  height="800"
                  loading="lazy"
                  decoding="async"
                />
                <span class="next-edition__tab-label">{tShowcase(`view_${view}`)}</span>
              </button>
            ))}
          </div>
        </div>
      )}

      <div class="next-edition__actions">
        <Button href={DISCORD_URL} size="lg">
          {tNext("cta_discord")}
        </Button>
        <Button href={`mailto:${CLUB.email}`} variant="outline" size="lg">
          {tNext("cta_email")}
        </Button>
      </div>
    </div>
  </jersey-gallery>
</section>
