---
import "./product-card.scss";
import { ROUTES } from "@config/routes";
import { isSoldOut, type Product, type ProductCategory } from "@/domain/store/product";
import { createTranslator, formatCurrency, localizePath } from "@/ui/i18n";

interface Props {
  product: Product;
}

const CATEGORY_KEY: Record<ProductCategory, string> = {
  jersey: "category_jersey",
  hoodie: "category_hoodie",
  sticker: "category_sticker",
};

const PLACEHOLDER_IMAGE = "/images/brand/crow6-mascot-full.svg";

const { product } = Astro.props;
const { locale } = Astro.locals;
const t = createTranslator(locale, "home.productCard");
const tStore = createTranslator(locale, "store");
const [image] = product.images;
const soldOut = isSoldOut(product);
---

<article class:list={["product-card", { "product-card--sold-out": soldOut }]}>
  <a href={localizePath(locale, ROUTES.store)} class="product-card__link">
    <div class="product-card__media">
      {image ? (
        <img
          src={image}
          alt={product.name}
          loading="lazy"
          decoding="async"
          class="product-card__img"
        />
      ) : (
        <img
          src={PLACEHOLDER_IMAGE}
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
          width="2163"
          height="1525"
          class="product-card__placeholder"
        />
      )}

      {product.featured && !soldOut && (
        <span class="product-card__featured">{t("featured_badge")}</span>
      )}
      {soldOut && <span class="product-card__sold-out">{tStore("sold_out")}</span>}
    </div>

    <div class="product-card__body">
      <div class="product-card__info">
        <span class="product-card__category">{t(CATEGORY_KEY[product.category])}</span>
        <h3 class="product-card__name">{product.name}</h3>
      </div>
      <p class="product-card__price">{formatCurrency(locale, product.price, product.currency)}</p>
    </div>
  </a>
</article>
