---
import "./product-card.scss";
import { ROUTES } from "@config/routes";
import type { Product, ProductCategory } from "@/domain/store/product";
import { createTranslator, formatCurrency, localizePath } from "@/ui/i18n";

interface Props {
  product: Product;
}

const CATEGORY_KEY: Record<ProductCategory, string> = {
  jersey: "category_jersey",
  hoodie: "category_hoodie",
  cap: "category_cap",
  accessory: "category_accessory",
};

const { product } = Astro.props;
const { locale } = Astro.locals;
const t = createTranslator(locale, "home.productCard");
const [image] = product.images;
---

<article class="product-card">
  <a href={localizePath(locale, ROUTES.store)} class="product-card__link">
    <div class="product-card__media">
      {image ? (
        <img src={image} alt={product.name} loading="lazy" class="product-card__img" />
      ) : (
        <div class="product-card__no-image" aria-hidden="true">
          <span class="product-card__no-image-icon">?</span>
        </div>
      )}
      <div class="product-card__top">
        <span class="product-card__category">{t(CATEGORY_KEY[product.category])}</span>
        {product.featured && <span class="product-card__featured">{t("featured_badge")}</span>}
      </div>
    </div>

    <div class="product-card__body">
      <h3 class="product-card__name">{product.name}</h3>
      <p class="product-card__price">{formatCurrency(locale, product.price, product.currency)}</p>
    </div>
  </a>
</article>
