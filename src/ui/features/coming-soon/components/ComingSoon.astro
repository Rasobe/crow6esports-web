---
import "./coming-soon.scss";
import { socialLinks } from "@config/site";
import { Icon, type IconName } from "@/ui/shared/components";

const SOCIAL_ICONS: Record<(typeof socialLinks)[number]["platform"], IconName> = {
  x: "x",
  instagram: "instagram",
  discord: "discord",
  twitch: "twitch",
  tiktok: "tiktok",
  youtube: "youtube",
};
---

<div class="coming-soon">
  <div class="coming-soon__bg-text" aria-hidden="true">
    C6
  </div>
  <div class="coming-soon__corner coming-soon__corner--tl" aria-hidden="true"></div>
  <div class="coming-soon__corner coming-soon__corner--tr" aria-hidden="true"></div>
  <div class="coming-soon__corner coming-soon__corner--bl" aria-hidden="true"></div>
  <div class="coming-soon__corner coming-soon__corner--br" aria-hidden="true"></div>

  <div class="coming-soon__inner">
    <div class="coming-soon__logo">
      <img src="/images/brand/crow6-mascot-full.svg" alt="Crow 6 Esports" width="160" height="48" />
    </div>

    <p class="coming-soon__eyebrow">
      <span aria-hidden="true"></span>
      Estamos preparando algo
      <span aria-hidden="true"></span>
    </p>

    <h1 class="coming-soon__title">
      PRÓXI<span>MA</span>MENTE
    </h1>

    <div class="coming-soon__divider" aria-hidden="true"></div>

    <p class="coming-soon__description">
      Estamos trabajando en una nueva experiencia para Crow 6 Esports. Vuelve pronto.
    </p>

    <div class="coming-soon__socials">
      {socialLinks.map((social) => (
        <a
          href={social.href}
          class="coming-soon__social"
          aria-label={social.label}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name={SOCIAL_ICONS[social.platform]} size={20} />
        </a>
      ))}
    </div>

    <span class="coming-soon__meta">EST. 2020 · HUESCA, ESPAÑA · ROCKET LEAGUE</span>
  </div>

  <p class="coming-soon__hashtag" aria-hidden="true">
    #GOCROWS
  </p>
</div>
