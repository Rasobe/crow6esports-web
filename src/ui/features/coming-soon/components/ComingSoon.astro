---
import "./coming-soon.scss";
import { socialLinks } from "@config/site";
import { createTranslator } from "@/ui/i18n";
import { Icon, type IconName } from "@/ui/shared/components";

const SOCIAL_ICONS: Record<(typeof socialLinks)[number]["platform"], IconName> = {
  x: "x",
  instagram: "instagram",
  discord: "discord",
  twitch: "twitch",
  tiktok: "tiktok",
  youtube: "youtube",
};

const t = createTranslator(Astro.locals.locale, "comingSoon");
---

<main class="coming-soon" id="main">
  <div class="coming-soon__decor" aria-hidden="true">
    <span class="coming-soon__corner coming-soon__corner--tl"></span>
    <span class="coming-soon__corner coming-soon__corner--tr"></span>
    <span class="coming-soon__corner coming-soon__corner--bl"></span>
    <span class="coming-soon__corner coming-soon__corner--br"></span>
  </div>

  <div class="coming-soon__inner">
    <img
      class="coming-soon__logo"
      src="/images/brand/crow6-mascot-full.svg"
      alt="Crow 6 Esports"
      width="160"
      height="48"
    />

    <p class="coming-soon__eyebrow">{t("eyebrow")}</p>

    <h1 class="coming-soon__title">{t("title")}</h1>

    <p class="coming-soon__description">{t("description")}</p>

    <nav class="coming-soon__socials" aria-label={t("socialsLabel")}>
      <ul class="coming-soon__socials-list">
        {socialLinks.map((social) => (
          <li>
            <a
              class="coming-soon__social"
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name={SOCIAL_ICONS[social.platform]} size={20} />
              <span class="coming-soon__sr-only">
                {social.label} ({t("newTab")})
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <p class="coming-soon__meta">{t("meta")}</p>
    <p class="coming-soon__hashtag">{t("hashtag")}</p>
  </div>
</main>
