---
import "./coaching-cta.scss";
import { CLUB } from "@config/club";
import { DISCORD_URL } from "@config/site";
import { createTranslator } from "@/ui/i18n";
import { Button, SectionBackdrop } from "@/ui/shared/components";

const t = createTranslator(Astro.locals.locale, "coaching.cta");
---

<section class="coaching-cta has-backdrop" aria-labelledby="coaching-cta-title">
  <SectionBackdrop image="ball" />
  <div class="coaching-cta__inner" data-reveal>
    <h2 id="coaching-cta-title" class="coaching-cta__title">
      {t("title")}
    </h2>
    <p class="coaching-cta__description">{t("description")}</p>
    <div class="coaching-cta__actions">
      <Button href={DISCORD_URL} size="lg">
        {t("discord")}
      </Button>
      <Button href={`mailto:${CLUB.email}`} variant="outline" size="lg">
        {t("email")}
      </Button>
    </div>
  </div>
</section>
