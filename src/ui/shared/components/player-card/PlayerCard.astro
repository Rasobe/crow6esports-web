---
import "./player-card.scss";
import type { Player } from "@/domain/team/player";
import { createTranslator } from "@/ui/i18n";
import { Icon } from "../icons";
import {
  SOCIAL_ICONS,
  ROLE_KEY,
  STATUS_KEY,
  formatStat,
  getActiveSocialLinks,
  getAge,
  getFlagEmoji,
  getInitial,
} from "./player-card.utils";

interface Props {
  player: Player;
  index: number;
}

const { player } = Astro.props;
const { locale } = Astro.locals;
const t = createTranslator(locale, "home.playerCard");

const { stats } = player;
const initial = getInitial(player.nickname);
const flag = getFlagEmoji(player.country);
const countryName = new Intl.DisplayNames([locale], { type: "region" }).of(
  player.country.toUpperCase(),
);
const age = getAge(player.birthYear);
const statusKey = STATUS_KEY[player.status];
const socialLinks = getActiveSocialLinks(player.socials);
---

<article class="player-card">
  <div class="player-card__media">
    {player.image ? (
      <img
        src={player.image}
        alt={player.nickname}
        loading="lazy"
        decoding="async"
        class="player-card__img"
      />
    ) : (
      <div class="player-card__avatar" aria-hidden="true">
        <span class="player-card__initial">{initial}</span>
      </div>
    )}
    <div class="player-card__overlay"></div>
    {statusKey && (
      <span
        class:list={[
          "player-card__status",
          { "player-card__status--highlight": player.status === "substitute" },
        ]}
      >
        {t(statusKey)}
      </span>
    )}
  </div>

  <div class="player-card__identity">
    <div class="player-card__meta">
      <p class="player-card__role">{t(ROLE_KEY[player.type])}</p>
      {flag && (
        <span class="player-card__country" role="img" aria-label={countryName} title={countryName}>
          <span aria-hidden="true">{flag}</span>
          <span aria-hidden="true">{player.country.toUpperCase()}</span>
        </span>
      )}
    </div>
    <h3 class="player-card__nickname">{player.nickname}</h3>
  </div>

  <dl class="player-card__stats">
    <div class="player-card__stat player-card__stat--primary">
      <dt class="player-card__stat-label">{t("stat_peak")}</dt>
      <dd class="player-card__stat-value">{formatStat(stats.peak, locale)}</dd>
    </div>
    {!!age && (
      <div class="player-card__stat player-card__stat--muted">
        <dt class="player-card__stat-label">{t("stat_age")}</dt>
        <dd class="player-card__stat-value">{age}</dd>
      </div>
    )}
  </dl>

  <div class="player-card__socials">
    {socialLinks.map(({ platform, href, label }) => (
      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        class="player-card__social-link"
        aria-label={label}
        title={label}
      >
        <Icon name={SOCIAL_ICONS[platform]} size={16} />
      </a>
    ))}
  </div>
</article>
