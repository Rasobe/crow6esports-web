---
import "./testimonials.scss";
import { TESTIMONIALS } from "@config/testimonials";
import { getTestimonials } from "@/application/testimonials/get-testimonials";
import { createTranslator } from "@/ui/i18n";

const VISIBLE_BY_DEFAULT = 3;

const { locale } = Astro.locals;
const t = createTranslator(locale, "testimonials");
const testimonials = getTestimonials(TESTIMONIALS, locale);
const hasExtra = testimonials.length > VISIBLE_BY_DEFAULT;
const hasActions = Astro.slots.has("actions");
---

<testimonials-list class="testimonials" aria-labelledby="testimonials-title" role="region">
  <div class="testimonials__inner">
    <header class="testimonials__header" data-reveal>
      <div class="testimonials__heading">
        <span class="section-label">{t("eyebrow")}</span>
        <h2 id="testimonials-title" class="testimonials__title">
          {t("title_lead")} <span class="testimonials__title-accent">{t("title_accent")}</span>
        </h2>
      </div>
    </header>

    <ul class="testimonials__list" id="testimonials-list" aria-label={t("list_label")} data-reveal>
      {testimonials.map(({ id, author, affiliation, quote, highlight }, index) => (
        <li
          class="testimonials__entry"
          hidden={index >= VISIBLE_BY_DEFAULT}
          data-extra={index >= VISIBLE_BY_DEFAULT || undefined}
        >
          <figure class="testimonials__item">
            {highlight && (
              <p class="testimonials__highlight">
                <span class="testimonials__highlight-label">{t("highlight_label")}</span>
                <strong class="testimonials__highlight-value">
                  {t(`highlight.${highlight.key}`, highlight.params)
                    .split(" · ")
                    .map((line) => (
                      <span class="testimonials__highlight-line">{line}</span>
                    ))}
                </strong>
              </p>
            )}
            <div class="testimonials__body">
              <blockquote class="testimonials__quote" id={`testimonial-${id}`}>
                <p>{quote}</p>
              </blockquote>
              <figcaption class="testimonials__author">
                <cite class="testimonials__name">{author}</cite>
                {affiliation && <span class="testimonials__affiliation">{affiliation}</span>}
              </figcaption>
            </div>
          </figure>
        </li>
      ))}
    </ul>

    {hasExtra && (
      <button
        type="button"
        class="testimonials__more"
        aria-expanded="false"
        aria-controls="testimonials-list"
        data-more-label={t("show_more")}
        data-less-label={t("show_less")}
      >
        {t("show_more")}
      </button>
    )}
    {hasExtra && (
      <noscript>
        <style>
          .testimonials__entry[hidden] {
            display: flex;
          }
          .testimonials__more {
            display: none;
          }
        </style>
      </noscript>
    )}

    {hasActions && (
      <div class="testimonials__footer" data-reveal>
        <slot name="actions" />
      </div>
    )}
  </div>
</testimonials-list>

<script>
  class TestimonialsList extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector<HTMLButtonElement>(".testimonials__more");
      if (!button) return;

      button.addEventListener("click", () => {
        const expanded = button.getAttribute("aria-expanded") !== "true";
        button.setAttribute("aria-expanded", String(expanded));
        button.textContent = expanded ? button.dataset.lessLabel! : button.dataset.moreLabel!;
        for (const entry of this.querySelectorAll<HTMLElement>("[data-extra]")) {
          entry.hidden = !expanded;
        }
      });
    }
  }

  if (!customElements.get("testimonials-list")) {
    customElements.define("testimonials-list", TestimonialsList);
  }
</script>
