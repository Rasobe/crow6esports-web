---
import "./section-header.scss";
import { createTranslator } from "@/ui/i18n";

interface Props {
  namespace: string;
}

const { namespace } = Astro.props;
const t = createTranslator(Astro.locals.locale, namespace);
---

<header class="section-header">
  <span class="section-label">{t("eyebrow")}</span>
  <h2 class="section-header__title">{t("title")}</h2>
  <p class="section-header__subtitle">{t("subtitle")}</p>
</header>
