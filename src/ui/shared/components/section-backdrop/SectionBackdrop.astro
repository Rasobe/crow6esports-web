---
import "./section-backdrop.scss";

type BackdropImage = "arena" | "lights" | "ball" | "fire" | "turf";
type BackdropFade = "both" | "top" | "bottom" | "none";

interface Props {
  image: BackdropImage;
  fade?: BackdropFade;
  strong?: boolean;
  eager?: boolean;
}

const { image, fade = "both", strong = false, eager = false } = Astro.props;
---

<div
  class:list={[
    "section-backdrop",
    `section-backdrop--fade-${fade}`,
    { "section-backdrop--strong": strong },
  ]}
  aria-hidden="true"
>
  <img
    class="section-backdrop__image"
    src={`/images/backgrounds/${image}.webp`}
    alt=""
    width="1280"
    height="720"
    loading={eager ? "eager" : "lazy"}
    decoding="async"
  />
</div>
