---
import "./not-found.scss";
import { navigationConfig } from "@config/navigation";
import { ROUTES } from "@config/routes";
import { createTranslator, localizePath } from "@/ui/i18n";
import { Button } from "../button";
import { Icon } from "../icons";

const { locale } = Astro.locals;
const t = createTranslator(locale, "notFound");
const tNav = createTranslator(locale, "footer.nav");
---

<main class="not-found">
  <div class="not-found__sweep" aria-hidden="true"></div>

  <div class="not-found__inner">
    <p class="not-found__tag" data-hero style="--hero-step: 0">
      {t("tag")}
    </p>

    <p class="not-found__code" aria-hidden="true" data-hero style="--hero-step: 1">
      <span class="not-found__digit">4</span>
      <span class="not-found__ball">
        <svg class="not-found__ball-art" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
          <defs>
            <radialGradient id="nf-ball-sphere" cx="36%" cy="30%" r="78%">
              <stop offset="0" stop-color="#4d4d4d" />
              <stop offset="0.55" stop-color="#1d1d1d" />
              <stop offset="1" stop-color="#070707" />
            </radialGradient>
            <radialGradient id="nf-ball-shade" cx="50%" cy="50%" r="50%">
              <stop offset="0.55" stop-color="#000" stop-opacity="0" />
              <stop offset="1" stop-color="#000" stop-opacity="0.78" />
            </radialGradient>
            <radialGradient id="nf-ball-light" cx="50%" cy="50%" r="50%">
              <stop offset="0" stop-color="#fff3b0" />
              <stop offset="0.45" stop-color="var(--brand)" />
              <stop offset="1" stop-color="var(--brand)" stop-opacity="0" />
            </radialGradient>
            <clipPath id="nf-ball-clip">
              <circle cx="100" cy="100" r="97" />
            </clipPath>
            <filter id="nf-ball-glow" x="-40%" y="-40%" width="180%" height="180%">
              <feGaussianBlur stdDeviation="2.6" />
            </filter>
          </defs>
          <circle cx="100" cy="100" r="97" fill="url(#nf-ball-sphere)" />
          <g clip-path="url(#nf-ball-clip)">
            <g class="nf-ball__panels">
              <path
                d="M230.1 175.1 L202.0 191.3 L173.9 175.1 L173.9 142.7 L202.0 126.5 L230.1 142.7 Z"
                class="nf-ball__panel nf-ball__panel--1"
              />
              <path
                d="M128.1 234.0 L100.0 250.2 L71.9 234.0 L71.9 201.6 L100.0 185.4 L128.1 201.6 Z"
                class="nf-ball__panel nf-ball__panel--0"
              />
              <path
                d="M26.1 175.1 L-2.0 191.3 L-30.1 175.1 L-30.1 142.7 L-2.0 126.5 L26.1 142.7 Z"
                class="nf-ball__panel nf-ball__panel--1"
              />
              <path
                d="M26.1 57.3 L-2.0 73.5 L-30.1 57.3 L-30.1 24.9 L-2.0 8.7 L26.1 24.9 Z"
                class="nf-ball__panel nf-ball__panel--0"
              />
              <path
                d="M128.1 -1.6 L100.0 14.6 L71.9 -1.6 L71.9 -34.0 L100.0 -50.2 L128.1 -34.0 Z"
                class="nf-ball__panel nf-ball__panel--1"
              />
              <path
                d="M230.1 57.3 L202.0 73.5 L173.9 57.3 L173.9 24.9 L202.0 8.7 L230.1 24.9 Z"
                class="nf-ball__panel nf-ball__panel--0"
              />
              <path
                d="M186.9 116.2 L158.9 132.4 L130.8 116.2 L130.8 83.8 L158.9 67.6 L186.9 83.8 Z"
                class="nf-ball__panel nf-ball__panel--0"
              />
              <path
                d="M157.5 167.2 L129.4 183.4 L101.4 167.2 L101.4 134.8 L129.4 118.6 L157.5 134.8 Z"
                class="nf-ball__panel nf-ball__panel--1"
              />
              <path
                d="M98.6 167.2 L70.6 183.4 L42.5 167.2 L42.5 134.8 L70.6 118.6 L98.6 134.8 Z"
                class="nf-ball__panel nf-ball__panel--0"
              />
              <path
                d="M69.2 116.2 L41.1 132.4 L13.1 116.2 L13.1 83.8 L41.1 67.6 L69.2 83.8 Z"
                class="nf-ball__panel nf-ball__panel--1"
              />
              <path
                d="M98.6 65.2 L70.6 81.4 L42.5 65.2 L42.5 32.8 L70.6 16.6 L98.6 32.8 Z"
                class="nf-ball__panel nf-ball__panel--0"
              />
              <path
                d="M157.5 65.2 L129.4 81.4 L101.4 65.2 L101.4 32.8 L129.4 16.6 L157.5 32.8 Z"
                class="nf-ball__panel nf-ball__panel--1"
              />
              <path
                d="M128.1 116.2 L100.0 132.4 L71.9 116.2 L71.9 83.8 L100.0 67.6 L128.1 83.8 Z"
                class="nf-ball__core"
              />
              <path
                d="M120.3 111.7 L100.0 123.4 L79.7 111.7 L79.7 88.3 L100.0 76.6 L120.3 88.3 Z"
                class="nf-ball__line nf-ball__line--glow"
                filter="url(#nf-ball-glow)"
              />
              <path
                d="M120.3 111.7 L100.0 123.4 L79.7 111.7 L79.7 88.3 L100.0 76.6 L120.3 88.3 Z"
                class="nf-ball__line"
              />
              <circle cx="100" cy="100" r="9" fill="url(#nf-ball-light)" />
            </g>
            <circle cx="100" cy="100" r="97" fill="url(#nf-ball-shade)" />
            <ellipse
              cx="68"
              cy="52"
              rx="38"
              ry="22"
              transform="rotate(-32 68 52)"
              fill="#fff"
              opacity="0.14"
            />
          </g>
          <circle cx="100" cy="100" r="97" fill="none" stroke="var(--brand)" stroke-width="4" />
        </svg>
      </span>
      <span class="not-found__digit">4</span>
    </p>

    <h1 class="not-found__title" data-hero style="--hero-step: 2">
      {t("title")}
    </h1>
    <p class="not-found__desc" data-hero style="--hero-step: 3">
      {t("desc")}
    </p>

    <div class="not-found__actions" data-hero style="--hero-step: 4">
      <Button href={ROUTES.home} size="lg">
        <Icon slot="icon" name="arrow-left" size={16} />
        {t("cta")}
      </Button>
    </div>

    <nav class="not-found__links" aria-label={t("links_label")} data-hero style="--hero-step: 5">
      <span class="not-found__links-label">{t("links_label")}</span>
      <ul class="not-found__grid">
        {navigationConfig.mainNav.map(({ href, labelKey }) => (
          <li class="not-found__item">
            <a class="not-found__link" href={localizePath(locale, href)}>
              <span>{tNav(labelKey)}</span>
              <Icon name="arrow-right" size={16} />
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</main>
