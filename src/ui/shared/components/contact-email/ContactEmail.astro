---
import "./contact-email.scss";
import { CLUB } from "@config/club";
import { ROUTES } from "@config/routes";
import { createTranslator, localizePath } from "@/ui/i18n";
import { Button } from "../button";
import { Icon } from "../icons";
import { encodeEmail } from "./email-obfuscation";

interface Props {
  /** `button` ofrece un botón principal con alternativas; `compact` es una línea para el pie. */
  variant?: "button" | "compact";
  /** Texto del botón principal; por defecto "Escribir por email". */
  label?: string;
}

const { variant = "button", label } = Astro.props;
const { locale } = Astro.locals;
const t = createTranslator(locale, "contactEmail");
// El email no va en claro en el HTML: el script lo decodifica y monta el texto y los enlaces.
// Sin JavaScript, los enlaces llevan a la sección de contacto de "Sobre nosotros".
const CONTACT_SECTION = `${ROUTES.aboutUs}#about-contact-title`;
---

<contact-email
  class:list={["contact-email", `contact-email--${variant}`]}
  data-email-encoded={encodeEmail(CLUB.email)}
>
  {variant === "button" ? (
    <Button href={CONTACT_SECTION} variant="outline" size="lg" data-mail-link>
      {label ?? t("write")}
    </Button>
  ) : (
    <p class="contact-email__line">
      <Icon name="mail" size={16} />
      <a
        class="contact-email__address"
        href={localizePath(locale, CONTACT_SECTION)}
        data-mail-link
        data-mail-text
      >
        {t("fallback")}
      </a>
    </p>
  )}

  <div class="contact-email__alternatives" aria-live="polite" hidden>
    {variant === "button" && (
      <p class="contact-email__hint">
        {t("hint")} <span class="contact-email__address" data-mail-text></span>
      </p>
    )}
    <div class="contact-email__actions">
      <button
        type="button"
        class="contact-email__copy"
        data-label-copy={t("copy")}
        data-label-copied={t("copied")}
      >
        {t("copy")}
      </button>
      <a
        class="contact-email__gmail"
        href={localizePath(locale, CONTACT_SECTION)}
        target="_blank"
        rel="noopener noreferrer"
      >
        {t("gmail")}
        <span class="contact-email__sr-only"> ({t("new_tab")})</span>
      </a>
    </div>
    <span class="contact-email__status" role="status" aria-live="polite"></span>
  </div>
</contact-email>

<script>
  import { decodeEmail } from "./email-obfuscation";
  import { getGmailComposeUrl } from "./gmail-compose-url";

  const FEEDBACK_MS = 2000;

  async function writeToClipboard(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const field = document.createElement("textarea");
      field.value = text;
      field.setAttribute("readonly", "");
      field.style.position = "fixed";
      field.style.opacity = "0";
      document.body.append(field);
      field.select();
      const copied = document.execCommand("copy");
      field.remove();
      return copied;
    }
  }

  class ContactEmail extends HTMLElement {
    private resetTimer = 0;

    connectedCallback() {
      const { emailEncoded } = this.dataset;
      if (!emailEncoded) return;
      const email = decodeEmail(emailEncoded);
      this.revealEmail(email);
      this.revealAlternativesOnClick();

      const button = this.querySelector<HTMLButtonElement>(".contact-email__copy");
      const status = this.querySelector<HTMLElement>(".contact-email__status");
      if (!button || !status) return;

      button.addEventListener("click", async () => {
        const copied = await writeToClipboard(email);
        if (!copied) return;

        const { labelCopy = "", labelCopied = "" } = button.dataset;
        button.textContent = labelCopied;
        button.setAttribute("data-copied", "");
        status.textContent = labelCopied;

        window.clearTimeout(this.resetTimer);
        this.resetTimer = window.setTimeout(() => {
          button.textContent = labelCopy;
          button.removeAttribute("data-copied");
          status.textContent = "";
        }, FEEDBACK_MS);
      });
    }

    /** Monta el email, el mailto y el enlace de Gmail, que el HTML no lleva en claro. */
    private revealEmail(email: string) {
      for (const link of this.querySelectorAll<HTMLAnchorElement>("[data-mail-link]")) {
        link.href = `mailto:${email}`;
      }
      for (const text of this.querySelectorAll<HTMLElement>("[data-mail-text]")) {
        text.textContent = email;
      }
      const gmail = this.querySelector<HTMLAnchorElement>(".contact-email__gmail");
      if (gmail) gmail.href = getGmailComposeUrl(email);
    }

    /**
     * Con el botón principal, la ayuda "¿No se abre tu app de correo?" aparece al pulsarlo: quien
     * tiene app de correo no la necesita y quien no la tiene la ve justo cuando no pasa nada.
     * La versión compacta (pie) la muestra siempre. Sin JavaScript sigue oculta: copiar y Gmail
     * necesitan el email decodificado.
     */
    private revealAlternativesOnClick() {
      const alternatives = this.querySelector<HTMLElement>(".contact-email__alternatives");
      if (!alternatives) return;
      const mailLink = this.querySelector<HTMLAnchorElement>("a[data-mail-link].btn");
      if (!mailLink) {
        alternatives.hidden = false;
        return;
      }

      mailLink.addEventListener("click", () => {
        alternatives.hidden = false;
        alternatives.setAttribute("data-revealed", "");
      });
    }

    disconnectedCallback() {
      window.clearTimeout(this.resetTimer);
    }
  }

  if (!customElements.get("contact-email")) {
    customElements.define("contact-email", ContactEmail);
  }
</script>
