---
import "./page-header.scss";

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="page-header">
  <span class="page-header__slash" aria-hidden="true"></span>
  <span class="page-header__watermark" aria-hidden="true">
    {title}
  </span>

  <div class="page-header__inner">
    {eyebrow && (
      <p class="page-header__eyebrow" data-hero style="--hero-step: 0">
        {eyebrow}
      </p>
    )}
    <h1 class="page-header__title" data-hero style="--hero-step: 1">
      {title}
    </h1>
    {description && (
      <p class="page-header__description" data-hero style="--hero-step: 2">
        {description}
      </p>
    )}
    <slot />
  </div>
</header>
