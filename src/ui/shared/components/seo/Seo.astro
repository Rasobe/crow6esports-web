---
import { siteConfig } from "@config/site";
import { createTranslator, DEFAULT_LOCALE, LOCALES, type Locale } from "@/ui/i18n";
import { buildPageTitle } from "@/ui/shared/lib/seo";

interface Props {
  title?: string;
  /** El título ya incluye la marca (la home) y no se le añade la plantilla. */
  absoluteTitle?: boolean;
  description: string;
  locale: Locale;
  path?: string;
  image?: string;
  /** Descripción de la imagen social; por defecto la de la imagen por defecto del sitio. */
  imageAlt?: string;
  noindex?: boolean;
}

const {
  title,
  absoluteTitle,
  description,
  locale,
  path = "",
  image = "/images/og-default.jpg",
  imageAlt,
  noindex,
} = Astro.props;

// Open Graph usa el formato idioma_REGIÓN
const OG_LOCALES: Record<Locale, string> = { es: "es_ES", en: "en_GB" };

const pageTitle = buildPageTitle(title, siteConfig.name, absoluteTitle);
const urlFor = (target: Locale) => `${siteConfig.url}/${target}${path}`;
const canonical = urlFor(locale);
const ogImage = `${siteConfig.url}${image}`;
const altText = imageAlt ?? createTranslator(locale, "site")("image_alt");
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={canonical} />
{LOCALES.map((target) => (
  <link rel="alternate" hreflang={target} href={urlFor(target)} />
))}
<link rel="alternate" hreflang="x-default" href={urlFor(DEFAULT_LOCALE)} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={OG_LOCALES[locale]} />
{LOCALES.filter((target) => target !== locale).map((target) => (
  <meta property="og:locale:alternate" content={OG_LOCALES[target]} />
))}
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={altText} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={altText} />
