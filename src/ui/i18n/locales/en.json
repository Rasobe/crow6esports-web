            "placeholder": "DD/MM/YYYY"
          },
          "country": {
            "label": "Country / Region",
            "placeholder": "Spain"
          },
          "availability_weekdays": {
            "label": "Weekday availability",
            "placeholder": "E.g.: Mon-Fri 18:00 to 22:00"
