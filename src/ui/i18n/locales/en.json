          "availability_weekends": {
            "label": "Weekend availability",
            "placeholder": "E.g.: Sat-Sun 10:00 to 23:00"
          },
          "availability_scrims": {
            "label": "Scrims availability",
            "placeholder": "E.g.: Wednesday and Friday 20:00"
          },
          "rltracker": {
            "label": "RLTracker link",
            "placeholder": "https://rocketleague.tracker.network/..."
          },
          "rank": {
            "label": "Current 2v2 rank (MMR)",
            "placeholder": "E.g.: 1830"
          },
          "peak": {
            "label": "Peak 2v2 (MMR)",
            "placeholder": "E.g.: 2120"
          },
          "hours_played": {
            "label": "Total hours played",
            "placeholder": "E.g.: 5000"
          },
          "playstyle": {
            "label": "Predominant playstyle",
            "placeholder": "Select a playstyle",
            "options": {
              "calm": "Calm and positioning",
              "intermediate": "Balanced",
              "mechanical": "Mechanical",
              "aggressive": "Aggressive"
            }
          },
          "highlights": {
            "label": "Clip or highlights",
            "placeholder": "YouTube, Medal, Twitch...",
            "hint": "Optional: share a clip or highlight of your gameplay"
          },
          "competitive_exp": {
            "label": "Do you have experience in competitive teams?",
            "options": {
              "yes": "Yes",
              "no": "No"
            }
          },
          "previous_teams": {
            "label": "Which teams have you been in?",
            "placeholder": "Team name, league, season..."
          },
          "reaction_mistakes": {
            "label": "How do you react when a teammate makes a repeated mistake?",
            "placeholder": "Be honest..."
          },
          "reaction_losses": {
            "label": "How do you react to a losing streak?",
            "options": {
              "encourage": "I encourage my teammates",
              "down": "I get down",
              "calm": "I stay calm and keep going"
            }
          },
          "looking_for": {
            "label": "What are you looking for in Crow 6 Esports?",
            "placeholder": "What do you expect from the team?"
          },
          "open_to_coaching": {
            "label": "Are you open to receiving coaching or doing VOD reviews?",
            "options": {
              "yes": "Yes",
              "no": "No",
              "maybe": "Maybe"
            }
          }
        },
        "validation": {
          "discord_required": "Discord ID is required",
          "birth_date_required": "Birth date is required",
          "country_required": "Country is required",
          "availability_weekdays_required": "Weekday availability is required",
          "availability_weekends_required": "Weekend availability is required",
          "availability_scrims_required": "Scrim availability is required",
          "rltracker_required": "RLTracker link is required",
          "rltracker_invalid": "Enter a valid RLTracker URL",
          "rank_required": "Rank is required",
          "peak_required": "Peak MMR is required",
          "hours_required": "Hours played are required",
          "playstyle_required": "Select a playstyle",
          "highlights_invalid": "Enter a valid URL",
          "competitive_exp_required": "This field is required",
          "reaction_mistakes_required": "Response too short, minimum 10 characters",
          "reaction_losses_required": "This field is required",
          "looking_for_required": "Response too short, minimum 10 characters",
          "coaching_required": "This field is required"
        },
        "error": {
          "submit_failed": "We couldn't send your application. Please try again in a few minutes."
        }
      },
      "success": {
        "eyebrow": "#GOCROWS",
        "title": "APPLICATION SENT",
