---
import "./navbar.scss";
import { navigationConfig } from "@config/navigation";
import { ROUTES } from "@config/routes";
import { Button } from "@/ui/shared/components";
import { createTranslator, localizePath, stripLocale } from "@/ui/i18n";
import { LocaleSwitcher } from "./_components/locale-switcher";
import { MobileMenu } from "./_components/mobile-menu";

const { locale } = Astro.locals;
const t = createTranslator(locale, "nav");
const currentPath = stripLocale(Astro.originPathname);

const links = navigationConfig.mainNav.map(({ href, labelKey }) => ({
  href,
  label: t(labelKey),
}));
---

<header class="navbar">
  <nav class="navbar__inner">
    <a href={localizePath(locale, ROUTES.home)} class="navbar__brand" aria-label={t("home_aria")}>
      <img
        class="navbar__logo"
        src="/images/brand/crow6-wordmark.svg"
        alt="Crow 6 eSports"
        width="92"
        height="32"
      />
    </a>

    <ul class="navbar__links">
      {links.map(({ href, label }) => {
        const isActive = currentPath.startsWith(href);
        return (
          <li>
            <a
              href={localizePath(locale, href)}
              class:list={["navbar__link", { "navbar__link--active": isActive }]}
              aria-current={isActive ? "page" : undefined}
            >
              {label}
            </a>
          </li>
        );
      })}
    </ul>

    <div class="navbar__actions">
      <LocaleSwitcher />
      <Button variant="primary" size="sm" href={ROUTES.tryouts} class="navbar__cta">
        {t("join")}
      </Button>
      <MobileMenu links={links} />
    </div>
  </nav>
</header>

<script>
  const SCROLLED_AFTER_PX = 8;

  const syncScrolled = () => {
    document
      .querySelector(".navbar")
      ?.toggleAttribute("data-scrolled", window.scrollY > SCROLLED_AFTER_PX);
  };

  window.addEventListener("scroll", syncScrolled, { passive: true });
  document.addEventListener("astro:page-load", syncScrolled);
  syncScrolled();

  const isModifiedClick = (event: MouseEvent) =>
    event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey;

  // Pulsar el enlace de la página en la que ya estás no recarga ni vuelve a navegar: sube al
  // principio. Va en captura para marcar el evento antes de que el router de Astro lo recoja.
  document.addEventListener(
    "click",
    (event) => {
      if (event.defaultPrevented || isModifiedClick(event)) return;

      const link = (event.target as Element).closest<HTMLAnchorElement>(".navbar a[href]");
      if (!link || link.closest(".locale-switcher") || link.target === "_blank") return;

      const destination = new URL(link.href, window.location.href);
      const isCurrentPage =
        destination.origin === window.location.origin &&
        destination.pathname === window.location.pathname &&
        destination.search === window.location.search &&
        !destination.hash;
      if (!isCurrentPage) return;

      event.preventDefault();
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      window.scrollTo({ top: 0, behavior: prefersReducedMotion ? "auto" : "smooth" });
    },
    true,
  );
</script>
