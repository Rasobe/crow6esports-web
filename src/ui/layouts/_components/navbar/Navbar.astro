---
import "./navbar.scss";
import { navigationConfig } from "@config/navigation";
import { ROUTES } from "@config/routes";
import { Button } from "@/ui/shared/components";
import { createTranslator, localizePath, stripLocale } from "@/ui/i18n";
import { LocaleSwitcher } from "./_components/locale-switcher";
import { MobileMenu } from "./_components/mobile-menu";

const { locale } = Astro.locals;
const t = createTranslator(locale, "nav");
const currentPath = stripLocale(Astro.originPathname);

const links = navigationConfig.mainNav.map(({ href, labelKey }) => ({
  href,
  label: t(labelKey),
}));
---

<header class="navbar">
  <nav class="navbar__inner">
    <a href={localizePath(locale, ROUTES.home)} class="navbar__brand" aria-label={t("home_aria")}>
      <img
        class="navbar__logo"
        src="/images/brand/crow6-wordmark.svg"
        alt="Crow 6 Esports"
        width="92"
        height="32"
      />
    </a>

    <ul class="navbar__links">
      {links.map(({ href, label }) => {
        const isActive = currentPath.startsWith(href);
        return (
          <li>
            <a
              href={localizePath(locale, href)}
              class:list={["navbar__link", { "navbar__link--active": isActive }]}
              aria-current={isActive ? "page" : undefined}
            >
              {label}
            </a>
          </li>
        );
      })}
    </ul>

    <div class="navbar__actions">
      <LocaleSwitcher />
      <Button variant="primary" size="sm" href={ROUTES.tryouts} class="navbar__cta">
        {t("join")}
      </Button>
      <MobileMenu links={links} />
    </div>
  </nav>
</header>

<script>
  const SCROLLED_AFTER_PX = 8;

  const syncScrolled = () => {
    document
      .querySelector(".navbar")
      ?.toggleAttribute("data-scrolled", window.scrollY > SCROLLED_AFTER_PX);
  };

  window.addEventListener("scroll", syncScrolled, { passive: true });
  document.addEventListener("astro:page-load", syncScrolled);
  syncScrolled();
</script>
