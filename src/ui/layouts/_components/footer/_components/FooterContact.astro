---
import { CLUB } from "@config/club";
import { createTranslator } from "@/ui/i18n";
import { Icon } from "@/ui/shared/components";
import { getLocationLabel } from "@/ui/shared/lib/club-info";

const { locale } = Astro.locals;
const t = createTranslator(locale, "footer");
const { email } = CLUB;
---

<div class="footer__column">
  <span class="footer__title">{t("contact.title")}</span>

  <ul class="footer__list footer__list--roomy">
    <li class="footer__contact-item">
      <Icon name="mail" size={16} />
      <a href={`mailto:${email}`}>{email}</a>
    </li>
    <li class="footer__contact-item">
      <Icon name="map-pin" size={16} />
      <span>{getLocationLabel(locale)}</span>
    </li>
  </ul>
</div>
