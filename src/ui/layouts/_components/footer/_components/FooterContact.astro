---
import { createTranslator } from "@/ui/i18n";
import { ContactEmail } from "@/ui/shared/components";

const t = createTranslator(Astro.locals.locale, "footer");
---

<div class="footer__column">
  <span class="footer__title">{t("contact.title")}</span>

  <ul class="footer__list footer__list--roomy">
    <li class="footer__contact-item">
      <ContactEmail variant="compact" />
    </li>
  </ul>
</div>
