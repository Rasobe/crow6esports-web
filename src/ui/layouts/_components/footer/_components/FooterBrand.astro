---
import { CLUB } from "@config/club";
import { socialLinks } from "@config/site";
import { createTranslator } from "@/ui/i18n";
import { Icon } from "@/ui/shared/components";
import { getLocationLabel } from "@/ui/shared/lib/club-info";

const { locale } = Astro.locals;
const t = createTranslator(locale, "footer");
---

<div class="footer__column">
  <img
    src="/images/brand/crow6-mascot-full.svg"
    alt=""
    aria-hidden="true"
    width="72"
    height="72"
    class="footer__logo"
  />

  <div>
    <p class="footer__text footer__text--lead">{t("brand_description")}</p>
    <p class="footer__text">
      {t("founded", { year: CLUB.foundedYear, location: getLocationLabel(locale) })}
    </p>
  </div>

  <ul class="footer__list footer__list--inline">
    {socialLinks.map((social) => (
      <li>
        <a
          href={social.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={social.label}
          class="footer__social"
        >
          <Icon name={social.platform} size={20} />
        </a>
      </li>
    ))}
  </ul>
</div>
