---
import { socialLinks } from "@config/site";
import { createTranslator } from "@/ui/i18n";
import { Icon, type IconName } from "@/ui/shared/components";

const SOCIAL_ICONS: Record<(typeof socialLinks)[number]["platform"], IconName> = {
  x: "x",
  instagram: "instagram",
  discord: "discord",
  twitch: "twitch",
  tiktok: "tiktok",
  youtube: "youtube",
};

const t = createTranslator(Astro.locals.locale, "footer");
---

<div class="footer__column">
  <img
    src="/images/brand/crow6-mascot-full.svg"
    alt="Crow6 mascot"
    width="72"
    height="72"
    class="footer__logo"
  />

  <div>
    <p class="footer__text footer__text--lead">{t("brand_description")}</p>
    <p class="footer__text">{t("founded")}</p>
  </div>

  <ul class="footer__list footer__list--inline">
    {socialLinks.map((social) => (
      <li>
        <a
          href={social.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={social.label}
          class="footer__social"
        >
          <Icon name={SOCIAL_ICONS[social.platform]} size={20} />
        </a>
      </li>
    ))}
  </ul>
</div>
