---
import { createTranslator } from "@/ui/i18n";
import { SkipLink } from "@/ui/shared/components";
import BaseLayout from "./BaseLayout.astro";
import { Footer, Navbar } from "./_components";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
}

const { title, description, path, noindex } = Astro.props;
const tSite = createTranslator(Astro.locals.locale, "site");
---

<BaseLayout
  title={title}
  description={description ?? tSite("description")}
  path={path}
  noindex={noindex}
>
  <slot name="head" slot="head" />
  <SkipLink targetId="main-content" />
  <Navbar />
  <main id="main-content" class="content-offset" tabindex="-1">
    <slot />
  </main>
  <Footer />
</BaseLayout>
