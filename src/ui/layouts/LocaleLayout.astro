---
import { createTranslator, type Locale } from "@/ui/i18n";
import { SkipLink } from "@/ui/shared/components";
import BaseLayout from "./BaseLayout.astro";
import { Footer, Navbar } from "./_components";

interface Props {
  title?: string;
  absoluteTitle?: boolean;
  description?: string;
  path?: string;
  noindex?: boolean;
  ogType?: "website" | "article";
  image?: string;
  imageAlt?: string;
  alternates?: Partial<Record<Locale, string>>;
  /** Destino del selector de idioma por idioma, si no es la misma ruta (artículos con otro slug). */
  localePaths?: Partial<Record<Locale, string>>;
  publishedTime?: Date;
  modifiedTime?: Date;
}

const { title, absoluteTitle, description, path, noindex, localePaths, ...social } = Astro.props;
const tSite = createTranslator(Astro.locals.locale, "site");
---

<BaseLayout
  title={title}
  absoluteTitle={absoluteTitle}
  description={description ?? tSite("description")}
  path={path}
  noindex={noindex}
  {...social}
>
  <slot name="head" slot="head" />
  <SkipLink targetId="main-content" />
  <Navbar localePaths={localePaths} />
  <main id="main-content" class="content-offset" tabindex="-1">
    <slot />
  </main>
  <Footer />
</BaseLayout>
