---
import { createTranslator } from "@/ui/i18n";
import SkipLink from "@/ui/shared/components/skip-link/SkipLink.astro";
import BaseLayout from "./BaseLayout.astro";
import Footer from "./_components/footer/Footer.astro";
import Navbar from "./_components/navbar/Navbar.astro";

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const { title, description, path } = Astro.props;
const tSite = createTranslator(Astro.locals.locale, "site");
---

<BaseLayout title={title} description={description ?? tSite("description")} path={path}>
  <SkipLink targetId="main-content" />
  <Navbar />
  <main id="main-content" class="content-offset" tabindex="-1">
    <slot />
  </main>
  <Footer />
</BaseLayout>
