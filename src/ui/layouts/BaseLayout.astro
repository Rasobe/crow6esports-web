---
import "@/styles/global.scss";
import { Font } from "astro:assets";
import SpeedInsights from "@vercel/speed-insights/astro";
import { Seo } from "@/ui/shared/components";

interface Props {
  title?: string;
  description: string;
  path?: string;
  noindex?: boolean;
}

const { title, description, path, noindex } = Astro.props;
const { locale } = Astro.locals;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-ui" preload />
    <Font cssVariable="--font-body" preload />
    <Seo title={title} description={description} locale={locale} path={path} noindex={noindex} />
  </head>
  <body>
    <SpeedInsights />
    <slot />
  </body>
</html>
